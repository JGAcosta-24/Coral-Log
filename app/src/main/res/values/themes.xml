<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main application theme. -->
    <style name="Theme.CoralLog" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Starting theme for the Splash Screen. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- The icon to be displayed in the center. -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- The background color of the splash screen. -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <!-- The theme to be used after the splash screen is dismissed. -->
        <item name="postSplashScreenTheme">@style/Theme.CoralLog</item>
    </style>
</resources>